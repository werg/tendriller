{
  "name": "tendriller-shared-notes",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "create": "node setup.mjs create",
    "setup:prepare": "node account-setup.mjs prepare",
    "setup:finish": "node account-setup.mjs finish",
    "host:adopt": "node host-adoption.mjs",
    "init": "node setup.mjs init",
    "build": "node build.mjs",
    "deploy": "npm run build && node publish.mjs",
    "logs": "npx tendril --session ./session.mjs --mode attach logs",
    "peer": "node session.mjs",
    "serve": "node assistant.mjs run",
    "assistant:prepare": "node assistant.mjs prepare",
    "assistant": "node assistant.mjs"
  }
}
