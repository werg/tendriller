{
  "name": "tendriller-engine",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/package-engine.mjs",
    "build:deploy": "node scripts/build.mjs --clean-public && node scripts/package-engine.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:host": "node scripts/dev-host.mjs",
    "copy:edit": "node scripts/copy-editor.mjs",
    "auth:hash-password": "node scripts/hash-password.mjs",
    "test": "npm run build && npm run test:server",
    "test:e2e": "npm run build && playwright test --config test/e2e/playwright.config.ts",
    "test:tts": "playwright test --config runtime/test/tts/playwright.config.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p runtime/tsconfig.json --noEmit && tsc -p contract/tsconfig.json --noEmit",
    "test:e2e:public": "npm run build && playwright test --config test/e2e/public.playwright.config.ts",
    "test:e2e:speech-real": "npm run build && E2E_REAL_SPEECH=1 playwright test --config test/e2e/speech-real.playwright.config.ts",
    "test:e2e:voice-controls": "playwright test --config runtime/test/voice-controls.playwright.config.ts",
    "test:e2e:all": "npm run test:e2e && npm run test:tts",
    "build:watch": "node scripts/build.mjs --watch",
    "contract:generate": "node scripts/contract.mjs --write",
    "contract:check": "node scripts/contract.mjs",
    "test:contract": "node --test contract/test/*.test.mjs",
    "test:collaboration": "node scripts/test-collaboration.mjs",
    "test:onboarding": "node --test scripts/test/onboarding.test.mjs",
    "test:first-app": "node scripts/test-first-app.mjs",
    "test:browser": "npm run build:artifacts && node scripts/test-browser.mjs",
    "check": "npm run contract:check && npm run build && npm run typecheck && npm run build:tools && npm run check:boundaries && npm --ignore-scripts run test:ci && npm run test:contract && npm run test:collaboration && npm run test:runtime-unit && npm run test:server && npm run test:consumer && npm run test:tools",
    "pretest:ci": "npm run build",
    "test:ci": "node --test --test-timeout=120000 scripts/test/*.test.mjs test/chaos/*.test.mjs",
    "check:release": "npm run check && node scripts/test-browser.mjs",
    "test:runtime-unit": "node --test --test-concurrency=1 runtime/test/*.test.mjs",
    "test:server": "vitest run --config server/vitest.public.config.ts",
    "test:consumer": "node scripts/test-consumer.mjs",
    "build:artifacts": "npm run build && npm run build:tools",
    "build:tools": "npm --prefix tools ci && node scripts/build-tools.mjs",
    "test:tools": "npm --prefix tools test",
    "test:tools:browser": "npm --prefix tools run test:browser",
    "release:artifacts": "node scripts/release.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:collaboration:native": "node --test collaboration/test/native*.test.mjs",
    "test:collaboration:browser": "node scripts/test-collaboration-browser.mjs",
    "test:plugin:live": "node scripts/review/qualify-live.mjs",
    "test:agent:acceptance": "node scripts/agent-acceptance/cli.mjs",
    "test:idle:soak": "node scripts/idle-soak/run.mjs",
    "test:idle:metrics": "node scripts/idle-soak/metrics.mjs",
    "test:first-app:feedback": "node scripts/test-first-app.mjs --feedback-qualification",
    "test:chaos": "node scripts/test-chaos.mjs"
  },
  "devDependencies": {
    "@chronolog/authority": "file:test/artifacts/chronolog-authority-50a23c63.tgz",
    "@chronolog/peer-session": "file:test/artifacts/chronolog-peer-session-50a23c63.tgz",
    "@cloudflare/vitest-plugin": "^1.8.1",
    "@cloudflare/workers-types": "^5.20261113.1",
    "@playwright/test": "^1.65.0",
    "esbuild": "^0.28.2",
    "miniflare": "5.20261110.2-beta",
    "typescript": "^7.0.2",
    "undici": "7.30.1",
    "vitest": "4.1",
    "wrangler": "^4.161.0"
  },
  "dependencies": {
    "@jitl/quickjs-ng-wasmfile-release-sync": "0.32.0",
    "ipaddr.js": "^2.5.0",
    "phonon-tts": "0.7.1",
    "quickjs-emscripten-core": "0.32.0"
  },
  "version": "0.3.0-rc.17",
  "engines": {
    "node": ">=22.15.0"
  }
}
