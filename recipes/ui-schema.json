{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tendriller agent-editable interface",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "blocks": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "type": {
            "enum": [
              "message",
              "status",
              "choice",
              "text",
              "slider",
              "button",
              "photo",
              "location",
              "file",
              "drawing",
              "hardware"
            ]
          },
          "connector": {
            "enum": [
              "screen",
              "clipboard",
              "contacts",
              "directory",
              "gamepad",
              "midi",
              "hid",
              "usb",
              "serial",
              "bluetooth",
              "nfc",
              "xr",
              "ambient_light",
              "magnetometer",
              "proximity",
              "accelerometer",
              "gyroscope"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 200
          },
          "text": {
            "type": "string",
            "maxLength": 2000
          },
          "options": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "string"
            }
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "value": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "type"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "blocks"
  ],
  "additionalProperties": false
}
