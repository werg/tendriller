{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private response notices and shared summary requests",
  "anyOf": [
    { "type": "object", "required": ["type", "response_id", "prompt_id", "revision"], "properties": {
      "type": { "const": "response_submitted" }, "response_id": { "type": "string" }, "prompt_id": { "type": "string" }, "revision": { "type": "integer", "minimum": 1 }
    }, "additionalProperties": false },
    { "type": "object", "required": ["type", "prompt_id"], "properties": {
      "type": { "const": "facilitation_summary_request" }, "prompt_id": { "type": "string" }
    }, "additionalProperties": false }
  ],
  "x-shared-state": { "facilitation": "{title?,stage:collect|discuss|closed,prompt:{id,text,description?},summary}" },
  "x-private-storage": "Responses live in the authenticated response API, never in shared state, transcript, or event payloads.",
  "x-participant-http": ["GET _tendril/responses returns {participant,responses}", "POST _tendril/responses {prompt_id,answer,expected_revision?}"],
  "x-facilitator-http": ["GET _tendril/responses/all", "GET A/responses"],
  "x-agent-instructions": "AGENT.md"
}
