{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private tasks, response notices and shared summary requests",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "type",
        "response_id",
        "prompt_id",
        "revision"
      ],
      "properties": {
        "type": {
          "const": "response_submitted"
        },
        "response_id": {
          "type": "string"
        },
        "prompt_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "prompt_id"
      ],
      "properties": {
        "type": {
          "const": "facilitation_summary_request"
        },
        "prompt_id": {
          "type": "string"
        },
        "session": {
          "type": "object",
          "required": [
            "scope",
            "id"
          ],
          "properties": {
            "scope": {
              "const": "facilitation"
            },
            "id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "assignment_id",
        "revision"
      ],
      "properties": {
        "type": {
          "const": "assignment_changed"
        },
        "assignment_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  ],
  "x-shared-state": {
    "facilitation": "{session_id?,title?,stage:collect|discuss|closed,prompt:{id,text,description?},summary}"
  },
  "x-private-storage": "Participant-specific tasks, feedback and answers live in authenticated APIs and private session archives. No private content enters shared state, transcript or event payloads.",
  "x-participant-http": [
    "GET _tendril/responses returns {participant,responses}",
    "GET _tendril/assignments returns {participant,assignments}",
    "POST _tendril/responses {prompt_id,answer,expected_revision?,expected_assignment_revision?,expected_session_id?}"
  ],
  "x-facilitator-http": [
    "GET _tendril/responses/all",
    "GET A/responses",
    "GET _tendril/assignments/participants",
    "GET _tendril/assignments/all",
    "POST _tendril/assignments",
    "PATCH _tendril/assignments/:id",
    "POST _tendril/archives"
  ],
  "x-agent-instructions": "AGENT.md"
}
