{
  "http": [
    { "method": "GET", "path": "/_tendril/devices", "json": { "devices": [{ "id": "$device.id", "name": "Controller tablet", "purpose": "controller", "connected": true }] } },
    { "method": "POST", "path": "/_tendril/focus", "json": { "ok": true } }
  ],
  "steps": [
    { "state_ops": [{ "op": "set", "path": ["workshop"], "value": { "title": "Build the paper bridge", "step": { "id": "fold", "title": "Fold the support", "instruction": "Fold the sheet in half along its long edge." } } }], "expect_text": "Fold the support" },
    { "click": "#done", "expect_send": { "type": "workshop.step_ack", "step_id": "fold" } },
    { "state_ops": [{ "op": "set", "path": ["workshop", "step"], "value": { "id": "test", "title": "Test the span", "instruction": "Place the folded support between the two blocks." } }], "reply": "Your first step is recorded. The next step is on every screen.", "expect_text": "Test the span" },
    { "click": "#pause", "expect_send": { "type": "workshop.pause", "paused": true }, "expect_text": "Workshop paused" },
    { "click": "#pause", "expect_send": { "type": "workshop.pause", "paused": false } },
    { "click": "#focus", "expect_text": "Attention moved to this device" }
  ]
}
