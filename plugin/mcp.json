{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "tendriller": {
      "type": "streamable-http",
      "url": "https://tendriller.dev/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "baseScopes": ["tendrils:list", "tendrils:create", "applications:read", "applications:write", "events:subscribe"],
            "defaultScopes": []
          }
        }
      }
    }
  }
}
