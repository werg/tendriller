{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tendriller.dev/contract/v3.json",
  "title": "Tendriller public contract v3",
  "$defs": {
    "agentRegistration": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "maxLength": 254,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]*$"
        },
        "publicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "required": [
        "owner",
        "name",
        "publicKey"
      ],
      "additionalProperties": false
    },
    "agentJoin": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]*$"
        },
        "publicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "required": [
        "code",
        "name",
        "publicKey"
      ],
      "additionalProperties": false
    },
    "agentCredential": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ag_[a-z2-7]{26}$"
        },
        "name": {
          "type": "string"
        },
        "token": {
          "type": "string",
          "pattern": "^ta_[a-z2-7]{32}$"
        },
        "account_state": {
          "enum": [
            "unclaimed",
            "claimed"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "token"
      ],
      "additionalProperties": true
    },
    "agentPageCreate": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "agentPage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z2-7]{12}$"
        },
        "name": {
          "type": "string"
        },
        "page_url": {
          "type": "string"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 16
        },
        "application": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "lifetime": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "page_url",
        "application"
      ],
      "additionalProperties": true
    },
    "agentPageList": {
      "type": "object",
      "properties": {
        "pages": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/agentPage"
          }
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "pages"
      ],
      "additionalProperties": true
    },
    "serviceDescriptor": {
      "type": "object",
      "properties": {
        "contract": {
          "const": 3
        },
        "core_release": {
          "type": "string"
        },
        "limits": {
          "type": "object"
        }
      },
      "required": [
        "contract",
        "core_release",
        "limits"
      ],
      "additionalProperties": false
    },
    "objectResponse": {
      "type": "object"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {}
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": true
    },
    "errorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "details": {}
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  }
}
