{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tendriller.dev/contract/v3.json",
  "title": "Tendriller public contract v3",
  "$defs": {
    "create": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "owner": {
          "type": "string",
          "maxLength": 254,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "lifetime": {
          "const": "ad_hoc"
        },
        "mode": {
          "enum": [
            "interactive",
            "dashboard"
          ]
        },
        "application": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "owner"
      ],
      "additionalProperties": false
    },
    "pageHandle": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "api": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "page_url": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "application": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "next_step": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "api",
        "token",
        "page_url",
        "application"
      ],
      "additionalProperties": true
    },
    "serviceDescriptor": {
      "type": "object",
      "properties": {
        "contract": {
          "const": 3
        },
        "core_release": {
          "type": "string"
        },
        "limits": {
          "type": "object"
        }
      },
      "required": [
        "contract",
        "core_release",
        "limits"
      ],
      "additionalProperties": false
    },
    "objectResponse": {
      "type": "object"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {}
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": true
    },
    "errorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "details": {}
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  }
}
