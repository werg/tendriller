{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tendriller.dev/contract/v3.json",
  "title": "Tendriller public contract v3",
  "$defs": {
    "agentRegistration": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "maxLength": 254,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "handle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]{1,31}$"
        },
        "bio": {
          "type": "string",
          "maxLength": 160
        },
        "publicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "wrapKey": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "owner",
        "handle",
        "publicKey",
        "wrapKey"
      ],
      "additionalProperties": false
    },
    "agentJoin": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "handle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]{1,31}$"
        },
        "bio": {
          "type": "string",
          "maxLength": 160
        },
        "publicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "wrapKey": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "code",
        "handle",
        "publicKey",
        "wrapKey"
      ],
      "additionalProperties": false
    },
    "agentProfileUpdate": {
      "type": "object",
      "properties": {
        "handle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]{1,31}$"
        },
        "bio": {
          "type": "string",
          "maxLength": 160
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "agentCredential": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ag_[a-z2-7]{26}$"
        },
        "handle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]{1,31}$"
        },
        "bio": {
          "type": "string",
          "maxLength": 160
        },
        "token": {
          "type": "string",
          "pattern": "^ta_[a-z2-7]{32}$"
        },
        "account_state": {
          "enum": [
            "unclaimed",
            "claimed"
          ]
        }
      },
      "required": [
        "id",
        "handle",
        "token"
      ],
      "additionalProperties": true
    },
    "agentPageCreate": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "mode": {
          "enum": [
            "interactive",
            "dashboard"
          ]
        },
        "application": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "subdomain": {
          "type": "string",
          "minLength": 3,
          "maxLength": 45,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{1,43}[a-z0-9])$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "pageAgent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "handle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]{1,31}$"
        },
        "bio": {
          "type": "string",
          "maxLength": 160
        },
        "public_key": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "workspace",
            "hosted-mcp"
          ]
        },
        "is_primary": {
          "type": "boolean"
        },
        "granted_at": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "handle",
        "bio",
        "public_key",
        "kind",
        "is_primary"
      ],
      "additionalProperties": true
    },
    "pageAgentRoster": {
      "type": "object",
      "properties": {
        "primary_agent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "agents": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/pageAgent"
          }
        }
      },
      "required": [
        "primary_agent_id",
        "agents"
      ],
      "additionalProperties": true
    },
    "agentPage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z2-7]{12}$"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "subdomain": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 3,
              "maxLength": 45,
              "pattern": "^[a-z0-9](?:[a-z0-9-]{1,43}[a-z0-9])$"
            },
            {
              "type": "null"
            }
          ]
        },
        "page_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "bare_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "fallback_page_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 16
        },
        "application": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "id"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "lifetime": {
          "type": "string"
        },
        "primary_agent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "is_primary": {
          "type": "boolean"
        },
        "agents": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/pageAgent"
          }
        }
      },
      "required": [
        "id",
        "page_url",
        "application"
      ],
      "additionalProperties": true
    },
    "agentPageList": {
      "type": "object",
      "properties": {
        "pages": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/agentPage"
          }
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "pages"
      ],
      "additionalProperties": true
    },
    "serviceDescriptor": {
      "type": "object",
      "properties": {
        "contract": {
          "const": 3
        },
        "core_release": {
          "type": "string"
        },
        "limits": {
          "type": "object"
        },
        "attestationKey": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "contract",
        "core_release",
        "limits",
        "attestationKey"
      ],
      "additionalProperties": false
    },
    "objectResponse": {
      "type": "object"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {}
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": true
    },
    "errorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "details": {}
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  }
}
