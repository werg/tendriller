{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tendriller-staging-s9",
  "main": "../dist/engine/worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*", "!/_tendril/runtime/3e10e3f3b74737fe0afdaab0d4b563574b0d4e7e5ae97fc850dc1e97ead6c0cb/*",
      "!/_tendril/brand/icon-64.png", "!/_tendril/brand/icon-180.png",
      "!/_tendril/brand/logo.png", "!/_tendril/brand/logo.webp",
      "!/_tendril/brand/favicon.ico", "!/favicon.ico"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TENDRIL",
        "class_name": "Tendril"
      },
      {
        "name": "ADMISSION",
        "class_name": "Admission"
      }
    ]
  },
  "migrations": [
    {
      "tag": "baseline",
      "new_sqlite_classes": [
        "Tendril",
        "Admission"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "ACCOUNTS",
      "database_name": "tendriller-staging-s9-accounts",
      "database_id": "93e78d5b-994c-4d45-b54f-ab5e69a03412",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "tendriller-staging-s9-files"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "CREATE_RATE",
      "namespace_id": "101",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "AGENT_RATE",
      "namespace_id": "102",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "PAGE_RATE",
      "namespace_id": "107",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      "name": "ACCOUNT_RATE",
      "namespace_id": "108",
      "simple": { "limit": 1800, "period": 60 }
    },
    {
      "name": "AUTH_RATE",
      "namespace_id": "104",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "FAILED_AUTH_RATE",
      "namespace_id": "105",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "REPORT_RATE",
      "namespace_id": "106",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "vars": {
    "PUBLIC_BASE": "https://staging.tendriller.dev",
    "PAGE_BASE_DOMAIN": "tendriller.dev",
    "PAGE_HOST_SUFFIX": "--p-9a9a9a9a9a9a",
    "CLOUDFLARE_ACCOUNT_ID": "f37a68d62a91924c32e2d3a5ff62d0ab"
  },
  "routes": [
    {
      "pattern": "staging.tendriller.dev/*",
      "zone_name": "tendriller.dev"
    },
    {
      "pattern": "*--p-9a9a9a9a9a9a.tendriller.dev/*",
      "zone_name": "tendriller.dev"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false }
  }
}
