{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tendriller-staging",
  "main": "../dist/engine/worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TENDRIL",
        "class_name": "Tendril"
      },
      {
        "name": "ADMISSION",
        "class_name": "Admission"
      }
    ]
  },
  "exports": {
    "Tendril": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "Admission": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "d1_databases": [
    {
      "binding": "ACCOUNTS",
      "database_name": "tendriller-staging-v4-accounts",
      "database_id": "26a4ff52-2f75-4820-9d0b-563ef0751cf6",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "tendriller-staging-v5-files"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "CREATE_RATE",
      "namespace_id": "101",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "AGENT_RATE",
      "namespace_id": "102",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "AUTH_RATE",
      "namespace_id": "104",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "FAILED_AUTH_RATE",
      "namespace_id": "105",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "REPORT_RATE",
      "namespace_id": "106",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "vars": {
    "PUBLIC_BASE": "https://staging.tendriller.dev",
    "PAGE_BASE_DOMAIN": "tendriller.dev",
    "CLOUDFLARE_ACCOUNT_ID": "f37a68d62a91924c32e2d3a5ff62d0ab"
  },
  "routes": [
    {
      "pattern": "staging.tendriller.dev",
      "custom_domain": true
    },
    {
      "pattern": "*.tendriller.dev/*",
      "zone_name": "tendriller.dev"
    }
  ],
  "observability": {
    "enabled": true
  }
}
