{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tendriller-production-s11",
  "workers_dev": false,
  "preview_urls": false,
  "main": "../dist/engine/worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_tendril/brand/icon-64.png", "!/_tendril/brand/icon-180.png",
      "!/_tendril/brand/logo.png", "!/_tendril/brand/logo.webp",
      "!/_tendril/brand/favicon.ico", "!/favicon.ico"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TENDRIL",
        "class_name": "TendrilS14"
      },
      {
        "name": "ADMISSION",
        "class_name": "AdmissionS14"
      },
      {
        "name": "AGENT_HUB",
        "class_name": "AgentHubS14"
      }
    ]
  },
  "migrations": [
    { "tag": "baseline", "new_sqlite_classes": ["Tendril", "Admission"] },
    { "tag": "agent-hub", "new_sqlite_classes": ["AgentHub"] },
    { "tag": "storage-13", "new_sqlite_classes": ["TendrilS13", "AdmissionS13", "AgentHubS13"] },
    { "tag": "storage-14", "new_sqlite_classes": ["TendrilS14", "AdmissionS14", "AgentHubS14"] }
  ],
  "d1_databases": [
    {
      "binding": "ACCOUNTS",
      "database_name": "tendriller-production-s14-accounts",
      "database_id": "0a5d94db-f381-4ec1-a363-2e62eee76ef1",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "tendriller-production-s11-files"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "CREATE_RATE",
      "namespace_id": "101",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "AGENT_RATE",
      "namespace_id": "102",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "PAGE_RATE",
      "namespace_id": "107",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      "name": "ACCOUNT_RATE",
      "namespace_id": "108",
      "simple": { "limit": 1800, "period": 60 }
    },
    {
      "name": "AUTH_RATE",
      "namespace_id": "104",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "FAILED_AUTH_RATE",
      "namespace_id": "105",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "REPORT_RATE",
      "namespace_id": "106",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "vars": {
    "PUBLIC_BASE": "https://tendriller.dev",
    "PAGE_BASE_DOMAIN": "tendriller.site",
    "CLOUDFLARE_ACCOUNT_ID": "f37a68d62a91924c32e2d3a5ff62d0ab"
  },
  "routes": [
    {
      "pattern": "tendriller.dev",
      "custom_domain": true
    },
    {
      "pattern": "*.tendriller.site/*",
      "zone_name": "tendriller.site"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false }
  }
}
