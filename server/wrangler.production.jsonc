{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tendriller-production",
  "main": "../dist/engine/worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*", "!/_tendril/runtime/30a9a8e2c5a78747e50b0a83b88c317f4961209684b27eb2ec9f955955affd74/*",
      "!/_tendril/brand/icon-64.png", "!/_tendril/brand/icon-180.png",
      "!/_tendril/brand/logo.png", "!/_tendril/brand/logo.webp",
      "!/_tendril/brand/favicon.ico", "!/favicon.ico"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TENDRIL",
        "class_name": "Tendril"
      },
      {
        "name": "ADMISSION",
        "class_name": "Admission"
      }
    ]
  },
  "exports": {
    "Tendril": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "Admission": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "d1_databases": [
    {
      "binding": "ACCOUNTS",
      "database_name": "tendriller-production-v4-accounts",
      "database_id": "2d383c8a-7620-46de-a601-c10b6166bb30",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "tendriller-production-v5-files"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "CREATE_RATE",
      "namespace_id": "101",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "AGENT_RATE",
      "namespace_id": "102",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "PAGE_RATE",
      "namespace_id": "107",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      "name": "ACCOUNT_RATE",
      "namespace_id": "108",
      "simple": { "limit": 1800, "period": 60 }
    },
    {
      "name": "AUTH_RATE",
      "namespace_id": "104",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "FAILED_AUTH_RATE",
      "namespace_id": "105",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "REPORT_RATE",
      "namespace_id": "106",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "vars": {
    "PUBLIC_BASE": "https://tendriller.dev",
    "PAGE_BASE_DOMAIN": "tendriller.site",
    "CLOUDFLARE_ACCOUNT_ID": "f37a68d62a91924c32e2d3a5ff62d0ab"
  },
  "routes": [
    {
      "pattern": "tendriller.dev",
      "custom_domain": true
    },
    {
      "pattern": "*.tendriller.site/*",
      "zone_name": "tendriller.site"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false }
  }
}
