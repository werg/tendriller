{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tendriller-production",
  "main": "../dist/service/worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TENDRIL",
        "class_name": "TendrilV4"
      },
      {
        "name": "ADMISSION",
        "class_name": "AdmissionV4"
      }
    ]
  },
  "exports": {
    "TendrilV3": { "type": "durable-object", "state": "deleted" },
    "Admission": { "type": "durable-object", "state": "deleted" },
    "TendrilV4": { "type": "durable-object", "storage": "sqlite" },
    "AdmissionV4": { "type": "durable-object", "storage": "sqlite" }
  },
  "d1_databases": [
    {
      "binding": "ACCOUNTS",
      "database_name": "tendriller-production-v4-accounts",
      "database_id": "2d383c8a-7620-46de-a601-c10b6166bb30",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "tendriller-production-v4-files"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "CREATE_RATE",
      "namespace_id": "101",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "AGENT_RATE",
      "namespace_id": "102",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "EVAL_RATE",
      "namespace_id": "103",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "AUTH_RATE",
      "namespace_id": "104",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "FAILED_AUTH_RATE",
      "namespace_id": "105",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "REPORT_RATE",
      "namespace_id": "106",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "FILE_READ_RATE",
      "namespace_id": "108",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "vars": {
    "PUBLIC_BASE": "https://tendriller.dev",
    "PAGE_BASE_DOMAIN": "tendriller.site",
    "CLOUDFLARE_ACCOUNT_ID": "f37a68d62a91924c32e2d3a5ff62d0ab"
  },
  "routes": [
    {
      "pattern": "tendriller.dev",
      "custom_domain": true
    },
    {
      "pattern": "*.tendriller.site/*",
      "zone_name": "tendriller.site"
    }
  ],
  "observability": {
    "enabled": true
  }
}
