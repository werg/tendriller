{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tendriller",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*", "!/_tendril/runtime/36dae66fea4bfffc675243009559c8281ca27a0f8e9ac433e5478d0f76304985/*",
      "!/_tendril/brand/icon-64.png", "!/_tendril/brand/icon-180.png",
      "!/_tendril/brand/logo.png", "!/_tendril/brand/logo.webp",
      "!/_tendril/brand/favicon.ico", "!/favicon.ico"
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "TENDRIL", "class_name": "Tendril" },
      { "name": "ADMISSION", "class_name": "Admission" }
    ]
  },
  "migrations": [
    { "tag": "baseline", "new_sqlite_classes": ["Tendril", "Admission"] }
  ],
  "d1_databases": [{
    "binding": "ACCOUNTS",
    "database_name": "tendriller-local-accounts",
    "database_id": "00000000-0000-4000-8000-000000000002",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [
    { "name": "CREATE_RATE", "namespace_id": "101", "simple": { "limit": 5, "period": 60 } },
    { "name": "AGENT_RATE", "namespace_id": "102", "simple": { "limit": 300, "period": 60 } },
    { "name": "PAGE_RATE", "namespace_id": "107", "simple": { "limit": 600, "period": 60 } },
    { "name": "ACCOUNT_RATE", "namespace_id": "108", "simple": { "limit": 1800, "period": 60 } },
    { "name": "AUTH_RATE", "namespace_id": "104", "simple": { "limit": 20, "period": 60 } },
    { "name": "FAILED_AUTH_RATE", "namespace_id": "105", "simple": { "limit": 20, "period": 60 } },
    { "name": "REPORT_RATE", "namespace_id": "106", "simple": { "limit": 5, "period": 60 } }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "tendriller-local-files" }],
  "vars": {
    "PUBLIC_BASE": "https://service.localhost",
    "PAGE_BASE_DOMAIN": "pages.localhost"
  }
  // Local development only. Deployment configs are generated by scripts/provision.mjs.
}
