{
  "releaseDirectory": "/opt/tendriller-chatgpt/releases/EXACT_CORE_COMMIT",
  "configurationDirectory": "/etc/tendriller-chatgpt",
  "stateDirectory": "/var/lib/tendriller-chatgpt",
  "coordinatorDirectory": "/var/lib/tendriller-kitchen/project",
  "sourceKitchenDirectory": "/absolute/private/configured-kitchen",
  "nodePath": "/usr/bin/node",
  "serviceUser": "tendriller-chatgpt",
  "coordinatorUser": "tendriller-kitchen",
  "resource": "https://assistant.example/mcp",
  "hostOrigin": "https://tendriller.example",
  "bridgeId": "kitchen-assistant",
  "oauthClient": {
    "id": "COPY_THE_CONFIGURED_CLIENT_ID",
    "name": "ChatGPT",
    "redirectUris": [],
    "scopes": ["tendrils:list", "applications:read", "applications:write", "events:subscribe"],
    "tokenEndpointAuthMethod": "none",
    "allowRefresh": true
  }
}
